# LabTrack backend environment
# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- MongoDB Atlas ---
# Either supply the four parts below (config/db.js assembles the SRV URI)...
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_CLUSTER_URL=cluster0.xxxxx.mongodb.net
MONGO_DB_NAME=labtrack
# ...or set MONGO_URI directly, which takes precedence over the four above.
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/labtrack?retryWrites=true&w=majority

# --- Auth ---
# Signs AND verifies user JWTs (middleware/authMiddleware.js). Required.
SECRET_KEY=
# JWT_SECRET is retired (Phase 1). Professional tokens are now signed with SECRET_KEY
# and carry a role claim, so authMiddleware can actually verify them.

# --- Supabase auth (Phase 1) ---
# Supabase signs access tokens either with asymmetric keys (discovered via JWKS from
# SUPABASE_URL) or with the project's shared JWT secret. Set whichever your project uses;
# set both if you are mid-rotation. With neither set, Supabase verification is inert and
# only legacy SECRET_KEY tokens are accepted, which is a valid pre-migration state.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=

# Set to true once every shipped client authenticates through Supabase. Until then,
# legacy SECRET_KEY tokens remain accepted so existing app builds keep working.
LEGACY_AUTH_DISABLED=false

# Service-role key (Dashboard → Project Settings → API → service_role). Needed only by
# scripts/setUserRole.js, which grants portal roles, and later by the staff invite flow.
# It BYPASSES row-level security — keep it server-side, never in a client bundle or any
# NEXT_PUBLIC_ variable. The API itself does not use it.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# Claude API key. Powers report vision parsing (claude-sonnet-5) and health interpretation
# (claude-opus-5). Required for both; without it the app falls back to manual entry and
# hides AI interpretation.
ANTHROPIC_API_KEY=

# DeepSeek key — RETIRED in Phase 4. /api/deepseek now returns 410. Safe to remove once no
# deployed app build calls it.
OPENAI_API_KEY=

# --- Speech to text (the assistant's Voice Mode) ---
# Claude cannot take audio, so POST /api/assistant/transcribe talks to a Whisper-compatible
# /audio/transcriptions endpoint. Its own key on purpose: OPENAI_API_KEY above holds a
# DeepSeek key, and pointing audio at it fails with an auth error nobody can explain.
#
# Leave TRANSCRIBE_API_KEY blank and voice input is simply unavailable — /assistant/status
# reports it, and the app greys the microphone out with a reason rather than failing on tap.
# Everything else about the assistant keeps working.
TRANSCRIBE_API_KEY=
# Any provider speaking the Whisper API shape: OpenAI, Groq, or a self-hosted faster-whisper.
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1

# --- Payments (Stripe) ---
# Server-side secret key. Test keys start sk_test_, live keys sk_live_.
# Leave blank to place orders unpaid — checkout falls back gracefully and says so.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_ / pk_live_). Safe to ship in the app; returned to the client.
STRIPE_PUBLISHABLE_KEY=
# Signing secret(s) from your Stripe webhook destinations (whsec_...). REQUIRED in
# production: without one the payload cannot be verified and is accepted unverified, so
# anyone who finds the URL could fake a successful payment.
# Each Stripe destination has its own secret — list several comma-separated and each is
# tried in turn (e.g. a hosted endpoint plus a `stripe listen` forward).
STRIPE_WEBHOOK_SECRET=whsec_xxx,whsec_yyy
# ISO currency, lowercase. Defaults to gbp.
STRIPE_CURRENCY=gbp

# --- Cloudflare Images (POST /api/images/upload, and photos sent to the assistant) ---
# Unset, the assistant still reads a photograph a person sends it — the upload is
# best-effort and only the stored copy is lost, so the transcript cannot redraw the picture
# when the screen is reopened.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Server ---
# Defaults to 5002 when unset. Render sets this automatically.
PORT=5002

# Comma-separated CORS allow list for browser clients — the staff web portal.
# Native apps send no Origin header and are unaffected by this setting.
# Unset falls back to http://localhost:3000, so a fresh checkout runs the portal as-is.
WEB_ORIGINS=https://portal.labtrack.example,http://localhost:3000
