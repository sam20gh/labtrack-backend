# LabTrack backend environment
# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- MongoDB Atlas ---
# Either supply the four parts below (config/db.js assembles the SRV URI)...
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_CLUSTER_URL=cluster0.xxxxx.mongodb.net
MONGO_DB_NAME=labtrack
# ...or set MONGO_URI directly, which takes precedence over the four above.
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/labtrack?retryWrites=true&w=majority

# --- Auth ---
# Signs AND verifies user JWTs (middleware/authMiddleware.js). Required.
SECRET_KEY=
# JWT_SECRET is retired (Phase 1). Professional tokens are now signed with SECRET_KEY
# and carry a role claim, so authMiddleware can actually verify them.

# --- Supabase auth (Phase 1) ---
# Supabase signs access tokens either with asymmetric keys (discovered via JWKS from
# SUPABASE_URL) or with the project's shared JWT secret. Set whichever your project uses;
# set both if you are mid-rotation. With neither set, Supabase verification is inert and
# only legacy SECRET_KEY tokens are accepted, which is a valid pre-migration state.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=

# Set to true once every shipped client authenticates through Supabase. Until then,
# legacy SECRET_KEY tokens remain accepted so existing app builds keep working.
LEGACY_AUTH_DISABLED=false

# --- AI ---
# Claude API key. Powers report vision parsing (claude-sonnet-5) and health interpretation
# (claude-opus-5). Required for both; without it the app falls back to manual entry and
# hides AI interpretation.
ANTHROPIC_API_KEY=

# DeepSeek key — RETIRED in Phase 4. /api/deepseek now returns 410. Safe to remove once no
# deployed app build calls it.
OPENAI_API_KEY=

# --- Cloudflare Images (POST /api/images/upload) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Server ---
# Defaults to 5002 when unset. Render sets this automatically.
PORT=5002
